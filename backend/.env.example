# Copy this file to `.env` and replace placeholder values.
# Never commit real secrets.

ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/parasite_seo
REDIS_URL=redis://localhost:6380/0

JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=http://localhost:3000

# Development seed only. Do not use in production.
SEED_DEV_DATA=false
SEED_USER_EMAIL=ashish@parasiteseo.ai
SEED_USER_PASSWORD=change-me-now

# Phase 3 — OpenRouter / LLM (backend only; never expose to the browser)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_AI_MODEL=openai/gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096
AI_TIMEOUT=90
AI_MAX_RETRIES=2
AI_MAX_GENERATION_CHARS=120000

# Future placeholders
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
SEO_PROVIDER_API_KEY=
ALLOW_HTTP_LINKS=false

# Phase 6 — public page base URL (no trailing slash). Empty = first CORS origin.
PUBLIC_APP_URL=http://localhost:3000
