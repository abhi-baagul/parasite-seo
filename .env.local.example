# Empty = call /api/* on the Next.js origin; next.config.ts proxies to FastAPI.
# Direct backend (requires CORS): NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=

# Backend target for the Next.js rewrite proxy.
# Local: http://127.0.0.1:8000
# Vercel: https://parasite-seo.onrender.com  (also the default when VERCEL=1)
API_PROXY_TARGET=http://127.0.0.1:8000
